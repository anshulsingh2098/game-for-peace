{
  "name": "game-for-peace",
  "compatibility_date": "2025-01-01",
  "main": "worker.js",
  // the worker only runs for /api/*; every other request is served straight from the static files
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] }
  // Publishing from the tuner needs these two, set up once (the API answers 503 until then, and the site is unaffected):
  //   1. cd cloudflare && npx wrangler kv namespace create SETTINGS      then add the id it prints:
  //        "kv_namespaces": [{ "binding": "SETTINGS", "id": "<that id>" }]
  //   2. npx wrangler secret put TUNER_PASSWORD
}
