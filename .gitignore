# Radio songs (large, and not ours to redistribute). playlist.json stays tracked.
*.mp3
*.m4a
*.wav
# our own engine loops (cut from Rajul's car recording) are not commercial music: keep them
!assets/audio/*.mp3
!assets/audio/*.wav

# Hand-made backups from before git; history replaces these
dev/*_before_*
dev/*_backup*

# Build outputs: regenerate with `python build_standalone.py`
game_standalone.html
game_artifact.html
dev/viewer.html

# Cloudflare local cache (holds account info)
.wrangler/

# Local tooling / OS noise
.claude/*
!.claude/commands/
__pycache__/
*.pyc
*.blend1
Thumbs.db
Desktop.ini

# raw downloaded map data (OpenStreetMap etc.): licences in docs/OPEN_DATA.md; only the small derived files in assets/ are committed
data/

# the city pack is staged into cloudflare/public by tools/stage_cloudflare.py at deploy time; it already lives in assets/cities (do not commit a second 77 MB copy)
cloudflare/public/assets/cities/
